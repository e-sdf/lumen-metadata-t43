# Credentials - never commit
.env
.env.*
!.env.example

# Elasticsearch scratchpads: queries.es carries the cluster host in its header,
# and the VS Code Elastic extension stores the user:password there too.
*.es

# Virtual environments
venv/
.venv/
env/

# Python bytecode and packaging leftovers
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Notebooks: checkpoint copies. main.ipynb itself is committed with its outputs,
# since the charts and timings are the point of it.
.ipynb_checkpoints/

# Lock files Excel writes next to a report that is open
~$*.xls*

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editor and OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db
